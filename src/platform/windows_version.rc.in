#include <winver.h>
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE @REY_RESOURCE_TYPE@
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Rey Audio"
      VALUE "FileDescription", "@REY_RESOURCE_DESCRIPTION@"
      VALUE "FileVersion", "@PROJECT_VERSION@.0"
      VALUE "InternalName", "@REY_RESOURCE_NAME@"
      VALUE "OriginalFilename", "@REY_RESOURCE_FILENAME@"
      VALUE "ProductName", "Rey Audio Driver"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
