#include <winver.h>
#include "resource.h"

1 24 "controls.manifest"
IDI_PIAOIP ICON "assets/PiAoIP.ico"
IDI_PIAOIP_GUIDE ICON "assets/PiAoIP-Guide.ico"

1 VERSIONINFO
FILEVERSION 2,5,0,0
PRODUCTVERSION 2,5,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "PiAoIP Project"
      VALUE "FileDescription", "PiAoIP Settings"
      VALUE "FileVersion", "2.5.0.0"
      VALUE "InternalName", "PiAoipControl"
      VALUE "OriginalFilename", "PiAoipControl.exe"
      VALUE "ProductName", "PiAoIP"
      VALUE "ProductVersion", "2.5.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
