<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rey Audio Driver" Width="1280" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#16243A"/>
    <SolidColorBrush x:Key="Muted" Color="#63748B"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="BorderBrush" Value="#E1E7EF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#EAF0F6"/><Setter Property="Foreground" Value="#203650"/>
      <Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#258C78"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#137F6C"/><Setter Property="Foreground" Value="White"/></Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#ABB8CA"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="12,3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavSurface" Padding="16,15" CornerRadius="10" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#26394A"/><Setter Property="Foreground" Value="#8BE5CA"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="#72DEBD"/><Setter TargetName="NavSurface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="11,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Option" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Option" Property="Background" Value="#E6F2EE"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Option" Property="Background" Value="#EAF0F6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="42"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,6"/><Setter Property="Foreground" Value="#203650"/><Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#CFDAE6"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <Border x:Name="ComboFrame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
        <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#63748B" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,5,0,0" Background="White" BorderBrush="#CFDAE6" BorderThickness="1" CornerRadius="9" Padding="5"><ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboFrame" Property="BorderBrush" Value="#137F6C"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboFrame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="42"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#203650"/><Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#CFDAE6"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="TextFrame" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="12,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextFrame" Property="BorderBrush" Value="#137F6C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#344A63"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="CheckFrame" Width="18" Height="18" CornerRadius="4" BorderBrush="#BFCEDB" BorderThickness="1" Background="#F8FAFD" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3 8 L 6 11 L 12 4" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/><Setter TargetName="CheckFrame" Property="Background" Value="#137F6C"/><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#137F6C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFrame" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#405970"/><Setter Property="FontSize" Value="13"/></Style>
    <Style x:Key="MixSwitch" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="#B6C6D8"/><Setter Property="Background" Value="#304056"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="5" Padding="5,8"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="#167E6D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#85E5C6"/><Setter TargetName="Face" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="MixFader" TargetType="Slider">
      <Setter Property="Orientation" Value="Vertical"/><Setter Property="Minimum" Value="-60"/><Setter Property="Maximum" Value="12"/><Setter Property="SmallChange" Value="0.1"/><Setter Property="LargeChange" Value="1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Width="34"><Border Width="3" Background="#42536A" CornerRadius="2" HorizontalAlignment="Center"/><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="False"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="32" Height="25"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Cap" Background="#88E5C6" CornerRadius="5" BorderBrush="#BAF1E0" BorderThickness="1"><Border Height="2" Background="#245C52" Margin="5,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="Cap" Property="Background" Value="#CEFFEE"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="ChannelStrip">
      <Border Background="#1D2B3F" CornerRadius="9" Margin="3,0" Padding="8,13">
        <StackPanel>
          <TextBlock Text="{Binding Name}" Foreground="#EFF6FF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding GainLabel}" Foreground="#9AE8CF" FontSize="12" Margin="0,10,0,15" HorizontalAlignment="Center"/>
          <Grid Height="140"><Grid.ColumnDefinitions><ColumnDefinition Width="13"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel><Border Height="8" Background="{Binding ClipColor}" CornerRadius="2" Margin="0,0,0,10" ToolTip="{Binding ClipHint}"/><Grid Height="110" Background="#121D2D"><Border Height="{Binding MeterHeight}" VerticalAlignment="Bottom"><Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="0,0"><GradientStop Color="#20B99B" Offset="0"/><GradientStop Color="#9FCA4B" Offset="0.72"/><GradientStop Color="#F5BD57" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid></StackPanel>
            <Slider Grid.Column="1" Style="{StaticResource MixFader}" Height="128" VerticalAlignment="Bottom" Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Уровень канала, dB" AutomationProperties.Name="{Binding Name}"/>
          </Grid>
          <TextBlock Text="{Binding PeakLabel}" Foreground="#8FABC5" FontSize="10" Margin="0,9,0,14" HorizontalAlignment="Center" ToolTip="Пиковый уровень после регулировки, dBFS"/>
          <UniformGrid Columns="2"><ToggleButton Content="M" IsChecked="{Binding Mute, Mode=TwoWay}" Style="{StaticResource MixSwitch}" Margin="0,0,3,0" ToolTip="Mute · выключить этот канал"/><ToggleButton Content="S" IsChecked="{Binding Solo, Mode=TwoWay}" Style="{StaticResource MixSwitch}" Margin="3,0,0,0" ToolTip="Solo · оставить выбранные каналы этого направления"/></UniformGrid>
          <ToggleButton Content="Ø" IsChecked="{Binding Invert, Mode=TwoWay}" Style="{StaticResource MixSwitch}" Margin="0,8,0,0" ToolTip="Инвертировать полярность PCM"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid x:Name="Root" Background="#F3F6FA">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#152132">
      <Grid><Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="*"/><RowDefinition Height="166"/></Grid.RowDefinitions>
        <StackPanel Margin="28,30,12,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="REY" Foreground="#85E5C6" FontSize="29" FontWeight="Bold"/><Border Background="#29394D" CornerRadius="5" Padding="8,3" Margin="12,9,0,0" VerticalAlignment="Top"><TextBlock Text="AUDIO" Foreground="#C6D2E2" FontSize="10" FontWeight="SemiBold"/></Border></StackPanel>
          <TextBlock Text="Audio Driver" Foreground="White" FontSize="17" Margin="0,10,0,0"/>
          <TextBlock Text="USB-аудио и микшер" Foreground="#8C9CB1" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <RadioButton x:Name="NavMixer" GroupName="Pages" IsChecked="True" Style="{StaticResource Nav}" Content="Микшер" AutomationProperties.Name="Mixer"/>
          <RadioButton x:Name="NavUsb" GroupName="Pages" Style="{StaticResource Nav}" Content="USB" AutomationProperties.Name="USB"/>
          <RadioButton x:Name="NavDiagnostics" GroupName="Pages" Style="{StaticResource Nav}" Content="Диагностика"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="28,18,24,22">
          <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{Binding ServiceColor}" Margin="0,0,9,0"/><TextBlock Text="{Binding ServiceLabel}" Foreground="#D7E0ED" FontSize="12"/></StackPanel>
          <TextBlock Text="Работает в фоне. Закрытие окна оставляет управление в трее." Foreground="#8C9CB1" FontSize="11" Margin="0,12,0,0" LineHeight="17"/>
          <TextBlock Text="2.8.0 · предварительная версия" Foreground="#63758E" FontSize="10" Margin="0,17,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="32,26,32,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding PageSubtitle}" Foreground="{StaticResource Muted}" Margin="0,7,12,0"/></StackPanel>
        <Button x:Name="ToTray" Grid.Column="1" Content="В трей" VerticalAlignment="Top" Padding="14,9" ToolTip="Свернуть окно. Служба продолжит работу."/>
      </Grid>
      <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16"><StackPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="USB-аудиокарта" Style="{StaticResource FieldLabel}"/><Border Background="#F3F7FA" CornerRadius="8" Padding="13,10"><TextBlock x:Name="AudioDeviceLabel" Text="{Binding DeviceLabel}" FontSize="16" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding DeviceHint}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel>
          <Button x:Name="WindowsSound" IsEnabled="{Binding CanUseWindowsSound}" Grid.Column="2" Content="Звук Windows" VerticalAlignment="Center" Padding="14,9" ToolTip="Выбрать системный выход или микрофон для обычных приложений"/>
        </Grid>
        <Grid Margin="0,15,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{Binding StatusColor}" CornerRadius="3"/>
        <StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="{Binding StatusTitle}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding StatusBody}" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="18" Margin="0,7,0,0"/></StackPanel>
      </Grid></StackPanel></Border>
      <Border Grid.Row="2" Background="#E4F2ED" Padding="16,11" CornerRadius="9" Margin="0,0,0,16" Visibility="{Binding MessageVisibility}"><TextBlock Text="{Binding Message}" Foreground="#246553" FontSize="12"/></Border>
      <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,9,0">
        <Grid>
          <StackPanel Visibility="{Binding MixerVisibility}">
            <Border Style="{StaticResource Card}" Padding="16,13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal"><RadioButton x:Name="MixerInputs" GroupName="MixerDirection" Content="Входы · 1–8" IsChecked="True" Margin="0,0,24,0" VerticalAlignment="Center"/><RadioButton x:Name="MixerOutputs" GroupName="MixerDirection" Content="Выходы · 1–8" VerticalAlignment="Center"/></StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding MixerFormat}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </Grid></Border>
            <Border Style="{StaticResource Card}" Padding="12,18"><StackPanel>
              <TextBlock Text="{Binding MixerSourceLabel}" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,17"/>
              <Grid IsEnabled="{Binding CanEditMixer}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                <ItemsControl x:Name="MixerStrips" ItemsSource="{Binding VisibleChannels}" ItemTemplate="{StaticResource ChannelStrip}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                <Border Grid.Column="2" Background="#26394A" CornerRadius="9" Padding="12,13"><StackPanel DataContext="{Binding Master}">
                  <TextBlock Text="MASTER" Foreground="#DBF5EB" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                  <TextBlock Text="Все 8 выходов" Foreground="#97B6C7" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                  <TextBlock Text="{Binding GainLabel}" Foreground="#9AE8CF" FontSize="14" Margin="0,12,0,17" HorizontalAlignment="Center"/>
                  <Slider Style="{StaticResource MixFader}" Maximum="6" Height="120" Value="{Binding Gain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Общий уровень выходов"/>
                  <ToggleButton Content="MUTE" IsChecked="{Binding Mute, Mode=TwoWay}" Style="{StaticResource MixSwitch}" Margin="0,26,0,0" ToolTip="Выключить все выходы"/>
                  <TextBlock Text="Применяется к воспроизведению" Foreground="#97B6C7" FontSize="10" TextAlignment="Center" Margin="0,17,0,0"/>
                </StackPanel></Border>
              </Grid>
            </StackPanel></Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="M · Mute   S · Solo   Ø · полярность. Уровни показывают реальный PCM. Входные настройки влияют на запись; выходные — на воспроизведение." Style="{StaticResource Caption}" Margin="0,0,22,0" LineHeight="18"/>
              <Button x:Name="ResetMixer" Grid.Column="1" Content="Сбросить микшер" IsEnabled="{Binding CanEditMixer}" VerticalAlignment="Top" Padding="14,9"/>
            </Grid>
            <TextBlock Text="{Binding EndpointHint}" Style="{StaticResource Caption}" Margin="0,14,0,0"/>
          </StackPanel>
          <StackPanel Visibility="{Binding UsbVisibility}">
            <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding UsbDeviceLabel}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding UsbConnectionLabel}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,10,0"/><TextBlock Text="{Binding ShortIdentity, StringFormat=ID · {0}}" Foreground="#8A98AA" FontSize="11" Margin="0,6,0,0"/></StackPanel>
            </Grid></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="Формат аудио" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Частота дискретизации" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UsbRate" ItemsSource="{Binding Rates}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UsbRate}" AutomationProperties.Name="USB sample rate"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Разрядность PCM" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Bits}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UsbBits}" AutomationProperties.Name="USB PCM bits"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Очередь USB" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UsbDepth" ItemsSource="{Binding Depths}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UsbDepth}" AutomationProperties.Name="USB queue depth"/></StackPanel>
              </Grid>
              <TextBlock Text="{Binding QueueHint}" Style="{StaticResource Caption}" Margin="0,13,0,9"/>
              <CheckBox Content="Подключать автоматически при появлении USB-устройства" IsChecked="{Binding UsbAutomatic}"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel>
              <TextBlock Text="USB-ASIO · Ableton / DAW" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <TextBlock Text="{Binding AsioStateLabel}" Foreground="#137F6C" FontSize="12" Margin="0,0,0,16"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Предпочитаемый блок ASIO" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Blocks}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AsioBlock}" AutomationProperties.Name="ASIO buffer size"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Запас отправки ASIO" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding AsioLeads}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding AsioLead}" AutomationProperties.Name="ASIO render lead"/></StackPanel>
              </Grid>
              <TextBlock Text="Для начала: 64 кадра, запас 3 блока, USB-очередь 3. Меньший блок требует проверки проекта в DAW. Значения меняются только вручную." Style="{StaticResource Caption}" Margin="0,13,0,13"/>
              <TextBlock Text="{Binding AsioCountersLabel}" Style="{StaticResource Caption}" Margin="0,0,0,13"/>
              <Button x:Name="SaveAsio" Content="Сохранить ASIO" HorizontalAlignment="Right" IsEnabled="{Binding CanSaveAsio}"/>
              <TextBlock Text="После сохранения заново выберите Rey Audio USB ASIO в Ableton. Драйвер использует одну подключённую USB-карту." Style="{StaticResource Caption}" Margin="0,13,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}" Padding="20,16"><Expander Header="Дополнительные настройки аудио в Windows"><StackPanel Margin="0,18,0,0">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Период аудиоустройства" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Blocks}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding UsbBlock}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Дополнительный запас, кадров" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding UsbGuard, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
              </Grid><TextBlock Text="Значения меняются вручную. Перед изменением формата остановите ASIO в Ableton." Style="{StaticResource Caption}" Margin="0,13,0,0"/>
            </StackPanel></Expander></Border>
            <Grid Margin="0,1,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Применение перезапускает только активную USB-сессию." Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button x:Name="SaveUsb" Grid.Column="1" Content="Применить USB" Style="{StaticResource Primary}" IsEnabled="{Binding CanApply}"/></Grid>
          </StackPanel>
          <StackPanel Visibility="{Binding DiagnosticsVisibility}">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Состояние системы" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,17"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Активный транспорт" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding RouteLabel}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Аудиодрайвер Windows" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding DriverLabel}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="USB-устройство" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ShortIdentity}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
              </Grid><TextBlock Text="{Binding BackendLabel, StringFormat=Источник · {0}}" Style="{StaticResource Caption}" Margin="0,16,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Текущая сессия" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <UniformGrid Columns="4">
                <StackPanel><TextBlock Text="Обработано блоков" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding CallbackLabel}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                <StackPanel><TextBlock Text="Кадров PCM" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding FrameLabel}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                <StackPanel><TextBlock Text="Пропущено кадров" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding MissingLabel}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                <StackPanel><TextBlock Text="Макс. пауза callback" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding GapLabel}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
              </UniformGrid><TextBlock Text="Пауза callback не является RTT или задержкой ADC/DAC. Счётчики относятся к текущему запуску сессии." Style="{StaticResource Caption}" Margin="0,17,0,0" LineHeight="18"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Последние события" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <ItemsControl ItemsSource="{Binding Events}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#8695A8" FontSize="12"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Button x:Name="CopyReport" Content="Копировать диагностику" HorizontalAlignment="Right" Margin="0,0,0,14"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
