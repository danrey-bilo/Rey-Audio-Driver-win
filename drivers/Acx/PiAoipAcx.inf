[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/03/2026,2.5.0.0
CatalogFile=PiAoipAcx.cat
PnpLockDown=1

[Manufacturer]
%Provider%=PiAoip,NTamd64.10.0...22621

[PiAoip.NTamd64.10.0...22621]
%Device%=PiAoipInstall,ROOT\PiAoipAcx

[DestinationDirs]
DefaultDestDir=13

[PiAoipInstall.NT]
CopyFiles=DriverFiles

[DriverFiles]
PiAoipAcx.sys

[PiAoipInstall.NT.Services]
AddService=PiAoipAcx,0x00000002,DriverService

[DriverService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\PiAoipAcx.sys

[PiAoipInstall.NT.Wdf]
KmdfService=PiAoipAcx,WdfSection

[WdfSection]
KmdfLibraryVersion=1.31

[SourceDisksNames]
1=%Disk%,,,""

[SourceDisksFiles]
PiAoipAcx.sys=1

[Strings]
Provider="PiAoIP"
Device="Pi AoIP network audio bridge"
Disk="PiAoIP ACX development driver"
