set(PI5AUSB_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/../lib/pi5-ausb" CACHE PATH "Pinned Pi5-AUSB transport checkout, or an empty value for an installed package")
if(PI5AUSB_SOURCE_DIR)
  if(NOT EXISTS "${PI5AUSB_SOURCE_DIR}/include/pi5ausb/linux.hpp")
    message(FATAL_ERROR "Initialize lib/pi5-ausb: git submodule update --init --recursive")
  endif()
  set(PI5AUSB_BUILD_TESTS OFF CACHE BOOL "" FORCE)
  set(PI5AUSB_BUILD_TOOLS OFF CACHE BOOL "" FORCE)
  add_subdirectory("${PI5AUSB_SOURCE_DIR}" "${CMAKE_BINARY_DIR}/ausb")
else()
  find_package(Pi5AUSB 0.3.0 EXACT CONFIG REQUIRED)
endif()
